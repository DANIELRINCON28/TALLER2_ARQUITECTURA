# ==================================
# TALLER2_ARQUITECTURA .gitignore
# ==================================

# ===== Python =====
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# Django specific
*.log
db.sqlite3
db.sqlite3-journal
/static/
/media/

# ===== PHP =====
# Composer
/vendor/
composer.lock

# PHP logs
*.log

# Environment variables
.env
.env.local
.env.*.local

# ===== IDEs =====
# VSCode
.vscode/
.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/

# NetBeans
nbproject/

# ===== OS =====
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ===== Bases de datos =====
# SQLite
*.sqlite
*.sqlite3
*.db

# MySQL
*.sql.gz

# ===== Archivos temporales =====
*.tmp
*.temp
*.swp
*.swo
*~

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Node (si se usa en el futuro) =====
node_modules/
package-lock.json
yarn.lock

# ===== Archivos de configuración sensibles =====
# Contraseñas, tokens, secrets
secrets.json
.secrets
*.key
*.pem

# ===== Carpetas antiguas (respaldo) =====
# Por si acaso quieres mantener respaldos temporales
old/
backup/
deprecated/

# ===== Cache =====
.cache/
*.cache

# ===== Coverage reports =====
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ===== Testing =====
.pytest_cache/
.tox/

# ===== Build artifacts =====
*.pyc
*.pyo
*.class

# ==================================
# Fin de .gitignore
# ==================================
